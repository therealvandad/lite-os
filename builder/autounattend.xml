<?xml version="1.0" encoding="utf-8"?>
<!--
  Lite OS - autounattend.xml TEMPLATE
  ===================================
  builder/Build-LiteOS.ps1 processes this file and writes the result to the ROOT of the
  Lite OS ISO as autounattend.xml. Windows Setup reads it automatically from the boot media.

  PLACEHOLDERS / MARKERS
  ......................
  LITEOS:BYPASS:BEGIN  and  LITEOS:BYPASS:END
      Each marker is an XML comment on its own line. Together they wrap the windowsPE
      RunSynchronous block that sets the Windows 11 hardware requirement bypass
      (HKLM\SYSTEM\Setup\LabConfig: BypassTPMCheck, BypassSecureBootCheck, BypassRAMCheck,
      BypassStorageCheck, BypassCPUCheck = 1) inside Windows Setup.
        - default build              : the two marker comments are removed, the block is kept.
        - Build-LiteOS.ps1 with the NoBypassRequirements switch
                                     : everything from BEGIN to END (inclusive) is removed.
      Keep the whole RunSynchronous element between the markers so the result is always
      valid (an empty RunSynchronous element is not allowed).

  There are no other tokens. The Lite OS mode, level, included/excluded tweaks and apps are
  NOT stored here: the builder writes them to C:\ProgramData\LiteOS\config.json inside the
  image. The builder also inserts one "Generated by" comment after the XML declaration.

  HOW LITE OS FINISHES THE INSTALL (Lite OS image v2)
  ...................................................
  Almost everything is already baked into the image by the builder (removed apps and
  components, tweaks, branding, Start/taskbar pins, installers). What is left runs twice:
    1. C:\Windows\Setup\Scripts\SetupComplete.cmd (written into the image by the builder, NOT
       part of this file) runs "LiteOS.ps1 -SetupComplete" as SYSTEM before the first sign-in:
       deferred machine tweaks, boot menu name, silent install of the baked installers.
    2. FirstLogonCommands below runs "LiteOS.ps1 -FirstLogon" once at the first sign-in:
       runs step 1 if Windows skipped SetupComplete (it does for OEM-key installs), applies the
       per-user leftovers to the new account and installs the optional winget apps. It only
       restarts when a deferred change needs it (with a 60 second notice).

  WHAT THIS FILE DOES
  ...................
  windowsPE   : requirement bypass (see above), AcceptEula and an EMPTY ProductKey element
                (Setup needs the element; it holds no key). Language, keyboard, product key
                and the target disk are still chosen by YOU on the Setup screens.
  specialize  : HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\OOBE BypassNRO = 1, so OOBE
                can finish without a network / Microsoft account.
  oobeSystem  : hides the EULA page and the online (Microsoft) account screens, keeps the
                network page, ProtectYourPC = 3 (privacy "express settings" not pre-enabled;
                Windows Update and Defender stay on in Lite mode), you create a LOCAL account
                in OOBE. FirstLogonCommands runs, once:
                powershell.exe -NoProfile -ExecutionPolicy Bypass -File C:\LiteOS\LiteOS.ps1 -FirstLogon

  SAFETY RULES (checked by Build-LiteOS.ps1 and the tests; do not remove)
  ............
  - NO DiskConfiguration, ImageInstall / InstallTo, partition or WillWipeDisk settings.
    Setup always stops at "Where do you want to install Windows?", so nothing is wiped and
    dual-boot setups stay safe. The only automatic actions are the registry values above.
  - NO product key. The only ProductKey element is the one in windowsPE UserData and its Key
    is EMPTY (Windows Setup stops with "cannot read the ProductKey setting" without the
    element). Setup still asks for your key (or "I don't have a product key"). Generic install
    keys are NOT included and no activation tool is used: activation uses your own license or
    the digital license already linked to your PC.
  - NO user accounts, passwords or AutoLogon. You create your account in OOBE.
-->
<unattend xmlns="urn:schemas-microsoft-com:unattend" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <settings pass="windowsPE">
    <component name="Microsoft-Windows-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <!-- LITEOS:BYPASS:BEGIN -->
      <RunSynchronous>
        <RunSynchronousCommand wcm:action="add">
          <Order>1</Order>
          <Path>reg.exe add HKLM\SYSTEM\Setup\LabConfig /v BypassTPMCheck /t REG_DWORD /d 1 /f</Path>
          <Description>Lite OS: skip the TPM 2.0 check in Setup</Description>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>2</Order>
          <Path>reg.exe add HKLM\SYSTEM\Setup\LabConfig /v BypassSecureBootCheck /t REG_DWORD /d 1 /f</Path>
          <Description>Lite OS: skip the Secure Boot check in Setup</Description>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>3</Order>
          <Path>reg.exe add HKLM\SYSTEM\Setup\LabConfig /v BypassRAMCheck /t REG_DWORD /d 1 /f</Path>
          <Description>Lite OS: skip the RAM check in Setup</Description>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>4</Order>
          <Path>reg.exe add HKLM\SYSTEM\Setup\LabConfig /v BypassStorageCheck /t REG_DWORD /d 1 /f</Path>
          <Description>Lite OS: skip the storage size check in Setup</Description>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>5</Order>
          <Path>reg.exe add HKLM\SYSTEM\Setup\LabConfig /v BypassCPUCheck /t REG_DWORD /d 1 /f</Path>
          <Description>Lite OS: skip the CPU generation check in Setup</Description>
        </RunSynchronousCommand>
      </RunSynchronous>
      <!-- LITEOS:BYPASS:END -->
      <UserData>
        <AcceptEula>true</AcceptEula>
        <!-- Windows Setup refuses an answer file whose windowsPE UserData has no ProductKey
             element ("Windows cannot read the <ProductKey> setting"). The Key is EMPTY on purpose:
             it is not a product key, so Setup still lets you enter your own key or choose
             "I don't have a product key". Build-LiteOS.ps1 refuses any non-empty Key. -->
        <ProductKey>
          <Key />
        </ProductKey>
      </UserData>
    </component>
  </settings>

  <settings pass="specialize">
    <component name="Microsoft-Windows-Deployment" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <RunSynchronous>
        <RunSynchronousCommand wcm:action="add">
          <Order>1</Order>
          <Path>reg.exe add HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\OOBE /v BypassNRO /t REG_DWORD /d 1 /f</Path>
          <Description>Lite OS: allow OOBE without a network connection (local account)</Description>
        </RunSynchronousCommand>
      </RunSynchronous>
    </component>
  </settings>

  <settings pass="oobeSystem">
    <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <FirstLogonCommands>
        <SynchronousCommand wcm:action="add">
          <Order>1</Order>
          <CommandLine>powershell.exe -NoProfile -ExecutionPolicy Bypass -File C:\LiteOS\LiteOS.ps1 -FirstLogon</CommandLine>
          <Description>Lite OS: finish setup for this account (SetupComplete fallback, per-user settings, optional apps)</Description>
          <RequiresUserInput>false</RequiresUserInput>
        </SynchronousCommand>
      </FirstLogonCommands>
      <OOBE>
        <HideEULAPage>true</HideEULAPage>
        <HideOnlineAccountScreens>true</HideOnlineAccountScreens>
        <HideWirelessSetupInOOBE>false</HideWirelessSetupInOOBE>
        <ProtectYourPC>3</ProtectYourPC>
      </OOBE>
    </component>
  </settings>

</unattend>
