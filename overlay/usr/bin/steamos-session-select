#!/bin/bash
# Called by Steam ("Switch to Desktop") and by the "Return to Console" launcher.
target="${1:-desktop}"
case "$target" in plasma*|desktop) t=desktop ;; *) t=console ;; esac
sudo -n /usr/bin/atlas-session-set "$t" "$USER" || exit 1
if [ "$t" = desktop ]; then
  steam -shutdown >/dev/null 2>&1 &
  sleep 3; pkill -x gamescope
else
  qdbus6 org.kde.Shutdown /Shutdown org.kde.Shutdown.logout 2>/dev/null \
    || loginctl terminate-session "$XDG_SESSION_ID"
fi
